{
  "name": "audio-playground",
  "version": "2.5.8",
  "description": "Kill Chain — a universal Windows audio engine for headphones, speakers, and home theater.",
  "author": "Jerry",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && node scripts/finalize-electron-build.mjs",
    "preview": "vite preview",
    "pack": "electron-builder --win --dir",
    "dist": "npm run build && node scripts/patch-electron-builder-sac.mjs && electron-builder --win nsis --publish never",
    "lint": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "framer-motion": "^11.11.7",
    "music-metadata": "^11.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5 || ^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.killchain.app",
    "productName": "Kill-Chain",
    "executableName": "Kill-Chain",
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "extraMetadata": {
      "type": "commonjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kill-Chain",
      "artifactName": "Kill-Chain-Setup-${version}.exe"
    }
  }
}
